generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String
  image     String?
  role      Role     @default(guest)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staff     Staff?   @relation("UserStaff")
}

model Staff {
  id                           Int               @id @default(autoincrement())
  userId                       Int?              @unique
  positionId                   Int?
  bankAccount                  String?           @unique
  bankName                     String?
  startDate                    DateTime
  code                         String            @unique
  social_security              String?           @unique
  currentSalary                Float
  updatedAt                    DateTime          @updatedAt
  taxid                        String?
  hireStatus                   Boolean           @default(true)
  TerminationDate              DateTime?
  Bill_Bill_deliveredByToStaff Bill[]            @relation("Bill_deliveredByToStaff")
  Bill_Bill_salesNameToStaff   Bill[]            @relation("Bill_salesNameToStaff")
  ExpenseCategory              ExpenseCategory[]
  orderLinks                   OrderPOStaff[]
  user                         User?             @relation("UserStaff", fields: [userId], references: [id])
  jobPosition                  JobPosition?      @relation(fields: [positionId], references: [id])
  StaffIncome                  StaffIncome[]
  StaffSalary                  StaffSalary[]

  @@index([positionId])
}

model JobPosition {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  baseSalary Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  staff      Staff[]
}

model Customer {
  id              Int       @id @default(autoincrement())
  name            String
  address         String
  tel             String?   @unique
  taxNumber       String    @unique
  faxNumber       String?   @unique
  email           String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  faxNumberSearch String?   @unique
  telSearch       String?   @unique
  Bill            Bill[]
  OrderPO         OrderPO[]
}

model Bill {
  id                            Int       @id @default(autoincrement())
  customerId                    Int
  codeCustomer                  String    @unique
  deliveryDate                  DateTime
  deliveryOrderNo               String?
  salesName                     String
  deliveredBy                   String?
  description                   String?
  vatRate                       Float     @default(7.0)
  subtotal                      Float?
  grandTotal                    Float?
  discount                      Float?
  vat                           Float
  dateReceive                   DateTime?
  salesNameId                   Int
  deliveredById                 Int?
  updatedAt                     DateTime  @updatedAt
  createdAt                     DateTime  @default(now())
  credit                        Int       @default(30)
  Customer                      Customer  @relation(fields: [customerId], references: [id])
  Staff_Bill_deliveredByToStaff Staff?    @relation("Bill_deliveredByToStaff", fields: [deliveredById], references: [id])
  Staff_Bill_salesNameToStaff   Staff     @relation("Bill_salesNameToStaff", fields: [salesNameId], references: [id])
  OrderPO                       OrderPO?

  @@index([customerId])
  @@index([salesNameId])
  @@index([deliveredById])
}

model OrderPO {
  id            Int       @id @default(autoincrement())
  poNumber      String?
  codetoinvoice Int       @unique @default(autoincrement())
  customerId    Int?
  billId        Int?      @unique
  status        JobStatus @default(pending)
  total         Float
  completedAt   DateTime?
  urlPo         String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bill          Bill?     @relation(fields: [billId], references: [id])
  Customer      Customer? @relation(fields: [customerId], references: [id])
  Invoice       Invoice?  @relation("OrderPO_Invoice")

  Product    Product[]
  staffLinks OrderPOStaff[]

  @@index([status])
  @@index([createdAt])
  @@index([customerId, status])
  @@index([billId])
  @@index([customerId])
}

model Invoice {
  id            Int      @id @default(autoincrement())
  codetoinvoice Int      @unique
  invoiceNo     Int      @default(autoincrement())
  createdAt     DateTime @default(now())

  OrderPO OrderPO @relation("OrderPO_Invoice", fields: [codetoinvoice], references: [codetoinvoice], onDelete: Cascade)

  @@index([codetoinvoice])
  @@index([invoiceNo])
}

model OrderPOStaff {
  orderPOId  Int
  staffId    Int
  role       OrderStaffRole
  assignedAt DateTime       @default(now())
  orderPO    OrderPO        @relation(fields: [orderPOId], references: [id], onDelete: Cascade)
  staff      Staff          @relation(fields: [staffId], references: [id])

  @@id([orderPOId, staffId, role])
  @@index([staffId])
  @@index([orderPOId, role])
}

model Product {
  id            Int           @id @default(autoincrement())
  orderPOId     Int
  steelId       Int
  wide          Float?
  length        Float
  thickness     Float
  amount        Int
  detail        String?
  actualWeight  Float?
  total         Float?
  cuttingMethod CuttingMethod @default(normal)
  job           Int?
  discount      Float?
  unitPrice     Float         @default(0)
  isOD          Boolean       @default(false)
  isPerAmount   Boolean       @default(false)
  isServices    Boolean       @default(false)
  OrderPO       OrderPO       @relation(fields: [orderPOId], references: [id], onDelete: Cascade)
  SteelType     SteelType     @relation(fields: [steelId], references: [id])

  @@index([orderPOId])
  @@index([steelId])
}

model StaffSalary {
  id            Int      @id @default(autoincrement())
  staffId       Int
  amount        Float
  effectiveDate DateTime
  detail        String?
  createdBy     Int?
  createdAt     DateTime @default(now())
  Staff         Staff    @relation(fields: [staffId], references: [id])

  @@unique([staffId, effectiveDate])
  @@index([staffId, effectiveDate(sort: Desc)])
}

model StaffIncome {
  id         Int              @id @default(autoincrement())
  amount     Float
  nameIncome String
  detail     String           @default("-")
  staffId    Int
  date       DateTime         @default(now())
  typeId     Int?
  Staff      Staff            @relation(fields: [staffId], references: [id])
  type       TypeStaffIncome? @relation(fields: [typeId], references: [id])

  @@index([staffId])
  @@index([typeId])
}

model TypeStaffIncome {
  id       Int           @id @default(autoincrement())
  amount   Float
  name     String
  types    String
  onDelete Boolean?      @default(false)
  incomes  StaffIncome[]
}

model SteelType {
  id         Int          @id @default(autoincrement())
  codeSteel  String
  detail     String?
  amount     Int          @default(0)
  shape      ShapeSteel   @default(square)
  price      Float
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  density    Float
  status     SteelStatus  @default(active)
  Product    Product[]
  SteelStock SteelStock[]

  @@unique([codeSteel, shape])
}

model SteelStock {
  id          Int         @id @default(autoincrement())
  width       Int?
  length      Int
  thickness   Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  steeltypeId Int
  status      StockStatus @default(available)
  quantity    Int         @default(0)
  SteelType   SteelType   @relation(fields: [steeltypeId], references: [id])

  @@unique([steeltypeId, width, length, thickness])
}

model Expense {
  id          Int             @id @default(autoincrement())
  description String
  amount      Float
  expenseDate DateTime
  categoryId  Int
  receiptUrl  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model ExpenseCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String
  staffId     Int
  expenses    Expense[]
  Staff       Staff     @relation(fields: [staffId], references: [id])
}

enum Role {
  superadmin
  guest
  clerk
  supervisor
  accountant
  cutter
  delivery
}

enum JobStatus {
  pending
  cutting
  weighing
  ready
  shipped
  completed
  canceled
}

enum ShapeSteel {
  square
  line
}

enum CuttingMethod {
  normal
  FB
  CNC
  RM
}

enum StockStatus {
  available
  withdrawn
}

enum SteelStatus {
  active
  inactive
  hold
}

enum OrderStaffRole {
  supervisor
  cutter
}
