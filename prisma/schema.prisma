generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String
  image     String?
  role      Role     @default(guest)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staff     Staff?   @relation("UserStaff")
}

model Bill {
  id                            Int       @id @default(autoincrement())
  customerId                    Int?
  yourRef                       String
  invoiceNo                     String    @unique
  credit                        DateTime
  deliveryDate                  DateTime
  deliveryOrderNo               String?
  salesName                     String?
  deliveredBy                   String?
  description                   String?
  vatRate                       Float     @default(7.0)
  subtotal                      Float?
  grandTotal                    Float?
  discount                      Float?
  vat                           Float
  dateReceive                   DateTime?
  typeBill                      String?
  salesNameId                   Int?
  deliveredById                 Int?
  updatedAt                     DateTime @updatedAt
  Customer                      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  Staff_Bill_deliveredByToStaff Staff?    @relation("Bill_deliveredByToStaff", fields: [deliveredById], references: [id], onDelete: SetNull)
  Staff_Bill_salesNameToStaff   Staff?    @relation("Bill_salesNameToStaff", fields: [salesNameId], references: [id], onDelete: SetNull)
  OrderPO                       OrderPO[]

  createdAt DateTime @default(now())
  

  @@index([customerId])
  @@index([salesNameId])
  @@index([deliveredById])
}

model Customer {
  id            Int             @id @default(autoincrement())
  code          String          @unique
  name          String
  address       String
  tel           String          @unique
  taxNumber     String          @unique
  faxNumber     String          @unique
  email         String          @unique
  Bill          Bill[]
  OrderPO       OrderPO[]
}

model OrderPO {
  id                Int       @id @default(autoincrement())
  poNumber          String    @unique
  customerId        Int?
  assignedCutterId  Int?
  billId            Int?
  status            JobStatus @default(pending)
  total             Float
  date              DateTime  @default(now())
  completedAt       DateTime?
  urlPo             String[]
  bill              Bill?     @relation(fields: [billId], references: [id], onDelete: SetNull)
  Customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  Staff             Staff?     @relation(fields: [assignedCutterId], references: [id], onDelete: SetNull)
  Product           Product[]

  @@index([status])
  @@index([date])
  @@index([customerId, status])
  @@index([billId])
  @@index([customerId])
  @@index([assignedCutterId])
}

model Product {
  id               Int      @id @default(autoincrement())
  orderPOId        Int
  steelId          Int
  wide             Float
  length           Float
  thickness        Float
  amount           Int
  detail           String?
  calculatedWeight Float?
  actualWeight     Float?
  actualWide       Float?
  actualLength     Float?
  actualThickness  Float?
  total            Float
  
  OrderPO          OrderPO @relation(fields: [orderPOId], references: [id], onDelete: Cascade)
  SteelType        SteelType @relation(fields: [steelId], references: [id], onDelete:Restrict)

  @@index([orderPOId])
  @@index([steelId])
}


model Staff {
  id                           Int           @id @default(autoincrement())
  userId                       Int?          @unique
  user                         User?         @relation("UserStaff", fields: [userId], references: [id], onDelete: SetNull)
  position                     String        @default("พนักงานทั่วไป")
  bankAccount                  String        @unique
  bankName                     String
  startDate                    DateTime
  code                         String        @unique
  social_security              String        @unique
  currentSalary                Float
  updatedAt                    DateTime @updatedAt
  OrderPO                      OrderPO[]
  Bill_Bill_deliveredByToStaff Bill[]        @relation("Bill_deliveredByToStaff")
  Bill_Bill_salesNameToStaff   Bill[]        @relation("Bill_salesNameToStaff")
  StaffIncome                  StaffIncome[]
  SalaryHistory                StaffSalary[]
}

model StaffSalary {
  id            Int      @id @default(autoincrement())
  staffId       Int
  amount        Float
  effectiveDate DateTime
  detail        String?
  createdBy     Int?
  createdAt     DateTime @default(now())

  Staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, effectiveDate])
  @@index([staffId, effectiveDate(sort: Desc)])
}

model StaffIncome {
  id      Int      @id @default(autoincrement())
  amount  Float
  nameIncome String
  detail  String   @default("-")
  staffId Int
  date    DateTime @default(now())
  Staff   Staff    @relation(fields: [staffId], references: [id])

  typeId   Int? 
  type     TypeStaffIncome? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  @@index([staffId])
  @@index([typeId])
}



model TypeStaffIncome {
  id        Int    @id @default(autoincrement())
  amount    Float
  name      String
  types     String
  incomes   StaffIncome[]
}
model SteelType{
  id        Int    @id @default(autoincrement())
  codeSteel String @unique
  detail    String?
  price     Float
  Product   Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  superadmin
  guest
  clerk
  supervisor
  cutter
  delivery
}

enum JobStatus { 
  pending 
  cutting 
  weighing 
  ready 
  shipped 
  completed 
  }
