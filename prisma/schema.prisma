generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String
  image     String?
  role      Role     @default(guest)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  superadmin
  guest
  clerk
  supervisor
  cutter
  delivery
}
