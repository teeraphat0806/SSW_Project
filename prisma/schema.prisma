generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String
  image     String?
  role      Role     @default(guest)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staff     Staff?   @relation("UserStaff")
}

model Bill {
  id                            Int       @id @default(autoincrement())
  customerId                    Int?
  yourRef                       String
  invoiceNo                     String    @unique
  credit                        DateTime
  deliveryDate                  DateTime
  deliveryOrderNo               String?
  salesName                     String?
  deliveredBy                   String?
  description                   String?
  unitPrice                     Float?
  discount                      Float?
  vat                           Float
  dateReceive                   DateTime?
  typeBill                      String?
  salesNameId                   Int?
  deliveredById                 Int?
  Customer                      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  Staff_Bill_deliveredByToStaff Staff?    @relation("Bill_deliveredByToStaff", fields: [deliveredById], references: [id], onDelete: SetNull)
  Staff_Bill_salesNameToStaff   Staff?    @relation("Bill_salesNameToStaff", fields: [salesNameId], references: [id], onDelete: SetNull)
  OrderPO                       OrderPO[]

  @@index([customerId])
  @@index([salesNameId])
  @@index([deliveredById])
}

model Customer {
  id            Int             @id @default(autoincrement())
  code          String          @unique
  name          String
  address       String
  tel           String          @unique
  taxNumber     String          @unique
  faxNumber     String          @unique
  email         String          @unique
  Bill          Bill[]
  OrderPO       OrderPO[]
  Rcptorg       Rcptorg[]
  TemporaryBill TemporaryBill[]
}

model OrderPO {
  id         Int       @id @default(autoincrement())
  poNumber   String
  customerId Int?
  total      Float
  vat        Float
  date       DateTime  @default(now())
  urlPo      String[]
  billId     Int?
  bill       Bill?     @relation(fields: [billId], references: [id], onDelete: SetNull)
  Customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  Product    Product[]

  @@index([billId])
  @@index([customerId])
}

model Product {
  id               Int      @id @default(autoincrement())
  steelType        String
  wide             Float
  length           Float
  thickness        Float
  amount           Int
  detail           String?
  actualWeight     Float?
  calculatedWeight Float?
  total            Float
  orderPOId        Int?
  OrderPO          OrderPO? @relation(fields: [orderPOId], references: [id], onDelete: SetNull)

  @@index([orderPOId])
}

model Rcptorg {
  id         Int       @id @default(autoincrement())
  date       DateTime
  numberNo   String
  customerId Int?
  totalPrice Float
  Customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
}

model Staff {
  id                           Int           @id @default(autoincrement())
  userId                       Int?          @unique
  user                         User?         @relation("UserStaff", fields: [userId], references: [id], onDelete: SetNull)
  position                     String        @default("พนักงานทั่วไป")
  bankAccount                  String        @unique
  bankName                     String
  startDate                    DateTime
  code                         String        @unique
  social_security              String        @unique
  currentSalary                Float
  Bill_Bill_deliveredByToStaff Bill[]        @relation("Bill_deliveredByToStaff")
  Bill_Bill_salesNameToStaff   Bill[]        @relation("Bill_salesNameToStaff")
  StaffIncome                  StaffIncome[]
  SalaryHistory                StaffSalary[]
}

model StaffSalary {
  id            Int      @id @default(autoincrement())
  staffId       Int
  amount        Float
  effectiveDate DateTime
  detail        String?
  createdBy     Int?
  createdAt     DateTime @default(now())

  Staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, effectiveDate])
  @@index([staffId, effectiveDate(sort: Desc)])
}

model StaffIncome {
  id      Int      @id @default(autoincrement())
  amount  Float
  nameIncome String
  detail  String   @default("-")
  staffId Int
  date    DateTime @default(now())
  Staff   Staff    @relation(fields: [staffId], references: [id])

  typeId   Int? 
  type     TypeStaffIncome? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  @@index([staffId])
  @@index([typeId])
}

model TemporaryBill {
  id                 Int       @id @default(autoincrement())
  orderNo            String    @unique
  order              String
  term               String
  dueDate            DateTime
  customerId         Int?
  shippingLocation   String
  numberNo           String
  date               DateTime
  no                 String
  description        String
  quantity           Int
  weight             Float
  unitPrice          Float
  amount             Float
  total              Float
  totalAfterDiscount Float
  vat                Float
  receivedBy         String
  deliveredBy        String
  Customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model TypeStaffIncome {
  id        Int    @id @default(autoincrement())
  amount    Float
  name      String
  types     String
  incomes  StaffIncome[]
}

enum Role {
  superadmin
  guest
  clerk
  supervisor
  cutter
  delivery
}