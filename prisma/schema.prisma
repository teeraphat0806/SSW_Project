generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String
  image     String?
  role      Role     @default(guest)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Staff     Staff?   @relation(fields: [staffId], references: [id],onDelete: SetNull)
  staffId   Int?     @unique
}

model Bill {
  id                            Int       @id @default(autoincrement())
  customerId                    Int?
  yourRef                       String
  invoiceNo                     String
  idPo                          Int?
  credit                        DateTime
  deliveryOrderNo               String?
  salesName                     String
  deliveredBy                   String?
  description                   String
  unitPrice                     Float?
  discount                      Float?
  vat                           Float
  dateReceive                   DateTime?
  typeBill                      String?
  Customer                      Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  Staff_Bill_deliveredByToStaff Staff?    @relation("Bill_deliveredByToStaff", fields: [deliveredBy], references: [name])
  OrderPO                       OrderPO?   @relation(fields: [idPo], references: [id], onDelete: SetNull)
  Staff_Bill_salesNameToStaff   Staff     @relation("Bill_salesNameToStaff", fields: [salesName], references: [name])
}

model Customer {
  id            Int             @id @default(autoincrement())
  code          String          @unique
  name          String
  address       String
  tel           String          @unique
  taxNumber     String          @unique
  faxNumber     String          @unique
  email         String          @unique
  Bill          Bill[]
  OrderPO       OrderPO[]
  Rcptorg       Rcptorg[]
  TemporaryBill TemporaryBill[]
}

model OrderPO {
  id         Int       @id @default(autoincrement())
  poNumber   String
  customerId Int?
  total      Float
  vat        Float
  date       DateTime  @default(now())
  Bill       Bill[]
  Customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  Product    Product[]
}

model Product {
  id               Int     @id @default(autoincrement())
  steelType        String
  wide             Float
  length           Float
  thickness        Float
  amount           Int
  actualWeight     Float?
  calculatedWeight Float?
  total            Float
  orderPOId        Int?
  OrderPO          OrderPO? @relation(fields: [orderPOId], references: [id], onDelete: SetNull)
}

model Rcptorg {
  id           Int      @id @default(autoincrement())
  date         DateTime
  numberNo     String
  customerId   Int?
  totalPrice   Float
  Customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model Staff {
  id                           Int           @id @default(autoincrement())
  name                         String        @unique
  position                     String        @default("พนักงานทั่วไป")
  bankAccount                  String        @unique
  startAt                      DateTime
  code                         String        @unique
  social_security              String        @unique
  Salary                       Float
  Bill_Bill_deliveredByToStaff Bill[]        @relation("Bill_deliveredByToStaff")
  Bill_Bill_salesNameToStaff   Bill[]        @relation("Bill_salesNameToStaff")
  User                         User? 
  StaffIncome                  StaffIncome[]
  SalaryHistory                StaffSalary[] 
}

model StaffSalary {
  id            Int       @id @default(autoincrement())
  staffId       Int
  amount        Float                
  effectiveDate DateTime           
  detail        String?              
  createdBy     Int?                
  createdAt     DateTime @default(now())

  Staff  Staff @relation(fields: [staffId], references: [id])

  @@index([staffId, effectiveDate(sort: Desc)])
  @@unique([staffId, effectiveDate]) 
}


model StaffIncome {
  id      Int    @id @default(autoincrement())
  Price   Float
  detail  String @default("-")
  name    String
  staffId Int
  date    DateTime  @default(now())
  Staff   Staff  @relation(fields: [staffId], references: [id])
}

model TemporaryBill {
  id                 Int      @id @default(autoincrement())
  orderNo            String   @unique
  order              String
  term               String
  dueDate            DateTime
  customerId         Int?
  shippingLocation   String
  numberNo           String
  date               DateTime
  no                 String
  description        String
  quantity           Int
  weight             Float
  unitPrice          Float
  amount             Float
  total              Float
  totalAfterDiscount Float
  vat                Float
  receivedBy         String
  deliveredBy        String
  Customer           Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

enum Role {
  superadmin
  guest
  clerk
  supervisor
  cutter
  delivery
}
